@startuml casos-de-uso
skinparam monochrome true
skinparam shadowing false
title Sistema de Aluguel de Carros - Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle

actor "Cliente" as CLI
actor "Agente" as AG
actor "Empresa" as EMP
actor "Banco" as BCO
AG <|-- EMP
AG <|-- BCO

rectangle "Sistema de Aluguel de Carros" {
  usecase "UC01 Cadastrar-se" as UC01
  usecase "UC02 Autenticar (login)" as UC02
  usecase "UC03 Gerenciar cadastro de cliente\n(consultar, modificar, excluir)" as UC03
  usecase "UC04 Cadastrar automóvel" as UC04
  usecase "UC05 Consultar automóveis" as UC05
  usecase "UC06 Introduzir pedido de aluguel" as UC06
  usecase "UC07 Consultar pedidos e status" as UC07
  usecase "UC08 Modificar pedido" as UC08
  usecase "UC09 Cancelar pedido" as UC09
  usecase "UC10 Avaliar pedido\n(análise financeira)" as UC10
  usecase "UC11 Executar contrato de aluguel" as UC11
  usecase "UC12 Associar contrato de crédito" as UC12
  usecase "UC13 Consultar clientes" as UC13
}

CLI --> UC01
CLI --> UC03
CLI --> UC04
CLI --> UC05
CLI --> UC06
CLI --> UC07
CLI --> UC08
CLI --> UC09
AG --> UC01
AG --> UC04
AG --> UC05
AG --> UC07
AG --> UC08
AG --> UC10
AG --> UC11
AG --> UC13
BCO --> UC12

UC03 ..> UC02 : <<include>>
UC06 ..> UC02 : <<include>>
UC07 ..> UC02 : <<include>>
UC08 ..> UC02 : <<include>>
UC09 ..> UC02 : <<include>>
UC10 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>
UC12 ..> UC11 : <<extend>>
@enduml
